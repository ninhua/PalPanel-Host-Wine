# Non-secret deployment example. Do not store passwords or tokens here.
PALPANEL_ROOT=/home/container/palworld_win
PALPANEL_RUNTIME_MODE=host_wine
PALPANEL_SERVER_DIR=/home/container/palworld_win/server
PALPANEL_WINE_PREFIX_DIR=/home/container/palworld_win/wineprefix
PALPANEL_WINE_BIN=wine64
PALPANEL_STEAMCMD_WINE_PREFIX_DIR=/home/container/palworld_win/wineprefix-steamcmd
PALPANEL_STEAMCMD_WINE_PREFIX_DIR=/home/container/palworld_win/wineprefix-steamcmd
PALPANEL_WINDOWS_STEAMCMD_DIR=/home/container/palworld_win/steamcmd
PALPANEL_PORTABLE_WINE_CURRENT=/home/container/palworld_win/runtime/wine/current
PALPANEL_XVFB_DISPLAY=:99

PALPANEL_LISTEN_ADDR=0.0.0.0:12559
PALPANEL_GAME_PORT=12559
PALPANEL_QUERY_PORT=27015
PALPANEL_REST_PORT=8212
PALPANEL_RCON_PORT=25575
PALPANEL_PALDEFENDER_REST_PORT=17993

PALPANEL_SAVE_INDEXER_ENABLED=true
PALPANEL_SAVE_INDEXER_URL=http://127.0.0.1:8090
PALPANEL_PALCALC_URL=http://127.0.0.1:8091

PALPANEL_STEAM_LOGIN_MODE=anonymous
PALPANEL_STEAM_LOGIN_ON_START=0
# PALPANEL_STEAM_USERNAME=explicit_user_only

GH_PROXY_BASE=https://v4.gh-proxy.org
GH_PROXY_FALLBACK=https://cdn.gh-proxy.org
NO_PROXY=127.0.0.1,localhost

PALPANEL_REQUIRE_AUTH=true
PALPANEL_LOG_LEVEL=info
